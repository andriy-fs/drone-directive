{
  "compilerOptions": {
    "target": "es2023",
    // DOM for `WebSocket`/`MessageEvent` only — this package renders nothing and
    // must never reach for `document`, `window`, or any Vite-specific global.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
