{
  "name": "drone-directive",
  "private": true,
  "version": "1.2.5",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "types",
    "protocol",
    "net",
    "chat",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:relay": "npm run dev -w server",
    "build": "npm run build -w client",
    "deploy": "./scripts/deploy.sh",
    "lint": "eslint .",
    "pack:client": "npm run build && node scripts/pack-dist.mjs",
    "publish:client": "npm run pack:client && npm publish ./client/.pack",
    "preview": "npm run preview -w client",
    "shot": "npm run shot -w client --",
    "shot:fpv": "npm run shot:fpv -w client --",
    "test": "npm run test -w net && npm run test -w chat && npm run test -w client",
    "test:watch": "npm run test:watch -w client",
    "type-check": "npm run type-check -w types && npm run type-check -w net && npm run type-check -w chat && npm run type-check -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.62.0"
  }
}
